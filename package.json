{
  "name": "spec-plans",
  "version": "0.0.0",
  "private": true,
  "description": "Author, evolve and track specifications outside the repository, review their maturity and dispatch agents to build them.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --type-aware --deny-warnings --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,html}": "prettier --write"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
