{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "env": { "SPEC_PLANS_HOME": "${workspaceFolder}/.vscode-test/spec-plans" },
      "preLaunchTask": "build"
    }
  ]
}
